#!/bin/bash
# Fix My Linux shell wrapper.
#
# opencode runs every bash tool command through this file (config "shell"),
# invoked as `bash -c <command>`. It is named "bash" so opencode treats it as
# bash. Before handing off to the real bash it:
#   - removes the app's private variables (server password, inline config),
#   - restores the user's real XDG directories,
#   - routes sudo through the in-app password prompt (sudo -A + askpass),
#   - in the Flatpak build, runs the command on the host instead of the sandbox.

shell_dir="${FML_SHELL_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}"
flatpak="${FML_FLATPAK:-0}"
# The per-launch sudo shim (askpass paths baked in); the bundled one is a fallback.
shim_dir="${FML_SHIM_DIR:-${shell_dir}/bin}"

for key in XDG_CONFIG_HOME XDG_DATA_HOME XDG_CACHE_HOME XDG_STATE_HOME; do
  real="FML_REAL_${key}"
  if [ -n "${!real}" ]; then
    export "${key}=${!real}"
  fi
  unset "$real"
done

while IFS= read -r name; do
  case "$name" in
    OPENCODE_* | ELECTRON_* | CHROME_* ) unset "$name" ;;
  esac
done < <(compgen -e)
unset FML_SHELL_DIR FML_FLATPAK FML_SHIM_DIR FML_ASKPASS_BIN FML_ASKPASS_SOCKET SUDO_ASKPASS

if [ "$flatpak" = "1" ]; then
  # The host command starts from the host session's own environment, so only
  # our additions are passed: the sandbox's PATH and XDG dirs point at /app
  # and ~/.var/app, which mean nothing (or the wrong thing) on the host. The
  # shim (in the runtime dir, which the host shares) goes in front of the
  # host's PATH there.
  exec flatpak-spawn --host --watch-bus \
    --env=DEBIAN_FRONTEND=noninteractive --env=SYSTEMD_PAGER= --env=PAGER=cat --env=GIT_PAGER=cat \
    /bin/bash -c 'PATH="$1:$PATH"; shift; exec /bin/bash "$@"' fml-host "$shim_dir" "$@"
fi

export PATH="${shim_dir}:${PATH}"
# Non-interactive defaults so commands never stop to wait for a keypress.
export DEBIAN_FRONTEND=noninteractive
export SYSTEMD_PAGER=
export PAGER=cat
export GIT_PAGER=cat

exec /bin/bash "$@"
